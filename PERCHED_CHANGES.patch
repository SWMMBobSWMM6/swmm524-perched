+//=============================================================================
+//  swmm524-perched: two-layer bio-retention cell with a conductivity-limited
+//  interface.  Layer 1 = SOIL (topsoil), layer 2 = SOIL2 (compacted soil),
+//  carried in the storage slot as an equivalent depth so the water balance,
+//  limits and reporting code are reused unchanged:
+//      theta2 = storageDepth * storage.voidFrac / storage.thickness,
+//      storage.voidFrac = SOIL2 porosity, storage.thickness = SOIL2 thickness.
+//=============================================================================
+
+double getInterfaceCap()
+//
+//  Purpose: finds the most water the lower layer can take in across the
+//           interface over the coming time step (ft/s), from Green-Ampt with
+//           the perched water depth added to the suction head.
+//
+{
+    TSoilLayer* s1 = &theLidProc->soil;
+    TSoilLayer* s2 = &theLidProc->soil2;
+    TGrnAmpt*   ga = &theLidUnit->soil2Infil;
+    double theta1 = theLidUnit->soilMoisture;
+    double theta2 = theLidUnit->storageDepth * theLidProc->storage.voidFrac /
+                    theLidProc->storage.thickness;
+    double head = 0.0, supply, avail, cap, saveS, deficit;
+
+    //... saturated (perched) depth at the bottom of the topsoil
+    if ( theta1 > s1->fieldCap )
+        head = s1->thickness * (theta1 - s1->fieldCap) /
+               (s1->porosity - s1->fieldCap);
+
+    //... water arriving at the interface: topsoil unsaturated K(theta1),
+    //    no more than the drainable water it holds
+    supply = getSoilPercRate(theta1) * StructF;
+    avail  = MAX(theta1 - s1->fieldCap, 0.0) * s1->thickness / Tstep;
+    supply = MIN(supply, avail);
+
+    //... the Green-Ampt deficit cannot exceed the lower layer's actual
+    //    free pore space
+    deficit = MAX(s2->porosity - theta2, 0.0);
+    if ( ga->IMD > deficit ) ga->IMD = deficit;
+
+    //... perched head acts on the wetting front through the suction term
+    saveS = ga->S;
+    ga->S = s2->suction + head;
+    cap = grnampt_getInfil(ga, Tstep, supply, 0.0, MOD_GREEN_AMPT);
+    ga->S = saveS;
+    return MAX(cap, 0.0);
+}
+
+//=============================================================================
+
+void perchedFluxRates(double x[], double f[])
+//
+//  Purpose: computes flux rates for the perched two-layer bio-retention cell.
+//  Input:   x = vector of storage levels (surface depth, theta1, equiv. depth)
+//  Output:  f = vector of flux rates
+//
+{
+    TSoilLayer* s1 = &theLidProc->soil;
+    TSoilLayer* s2 = &theLidProc->soil2;
+    double L1  = s1->thickness;
+    double L2  = theLidProc->storage.thickness;
+    double vf2 = theLidProc->storage.voidFrac;
+    double surfaceDepth = x[SURF];
+    double soilTheta    = x[SOIL];
+    double storageDepth = x[STOR];
+    double theta2, availVolume, maxRate;
+
+    //... convert moisture levels to volumes
+    SurfaceVolume = surfaceDepth * theLidProc->surface.voidFrac;
+    SoilVolume    = soilTheta * L1;
+    StorageVolume = storageDepth * vf2;              // = theta2 * L2
+    theta2        = StorageVolume / L2;
+
+    //... ET: surface water, then topsoil to its WP, then SOIL2 to its WP
+    availVolume = SoilVolume - s1->wiltPoint * L1;
+    getEvapRates(SurfaceVolume, 0.0, availVolume,
+                 MAX(StorageVolume - s2->wiltPoint * L2, 0.0), 1.0);
+    if ( soilTheta >= s1->porosity ) StorageEvap = 0.0;
+
+    //... topsoil percolation toward the interface
+    SoilPerc = getSoilPercRate(soilTheta) * StructF;
+    availVolume = (soilTheta - s1->fieldCap) * L1;
+    maxRate = MAX(availVolume, 0.0) / Tstep - SoilEvap;
+    SoilPerc = MIN(SoilPerc, maxRate);
+    SoilPerc = MAX(SoilPerc, 0.0);
+
+    //... the compacted layer accepts no more than its Green-Ampt capacity
+    SoilPerc = MIN(SoilPerc, InterfaceCap);
+
+    //... drainage out of SOIL2: its own K(theta2), capped by the seepage
+    //    rate on the STORAGE line, never below field capacity
+    StorageExfil = 0.0;
+    if ( theta2 > s2->fieldCap )
+        StorageExfil = s2->kSat * exp(-(s2->porosity - theta2) * s2->kSlope);
+    StorageExfil = MIN(StorageExfil, getStorageExfilRate());
+    maxRate = MAX(theta2 - s2->fieldCap, 0.0) * L2 / Tstep + SoilPerc - StorageEvap;
+    StorageExfil = MIN(StorageExfil, MAX(maxRate, 0.0));
+    StorageDrain = 0.0;
+
+    //... limit topsoil percolation by unused SOIL2 pore space
+    maxRate = StorageExfil + StorageEvap + (s2->porosity - theta2) * L2 / Tstep;
+    SoilPerc = MIN(SoilPerc, MAX(maxRate, 0.0));
+
+    //... limit surface infiltration by unused topsoil pore space
+    maxRate = (s1->porosity - soilTheta) * L1 / Tstep + SoilPerc + SoilEvap;
+    SurfaceInfil = MIN(SurfaceInfil, maxRate);
+
+    //... surface outflow and layer flux rates
+    SurfaceOutflow = getSurfaceOutflowRate(surfaceDepth);
+    f[SURF] = (SurfaceInflow - SurfaceEvap - SurfaceInfil - SurfaceOutflow) /
+              theLidProc->surface.voidFrac;
+    f[SOIL] = (SurfaceInfil - SoilEvap - SoilPerc) / L1;
+    f[STOR] = (SoilPerc - StorageEvap - StorageExfil) / vf2;
+}
+
+//=============================================================================
+
+void updateStructFactor()
+//
+//  Purpose: first-order decay of topsoil structure while the topsoil is
+//           saturated, recovery while it is at or below field capacity.
+//
+{
+    double theta = theLidUnit->soilMoisture;
+    double sf    = theLidUnit->structFactor;
+    double smin  = theLidProc->structMin;
+    double days  = Tstep / SECperDAY;
+
+    if ( theta >= theLidProc->soil.porosity - 0.01 )
+        sf = smin + (sf - smin) * exp(-theLidProc->structKd * days);
+    else if ( theta <= theLidProc->soil.fieldCap )
+        sf = 1.0 - (1.0 - sf) * exp(-theLidProc->structKr * days);
+    theLidUnit->structFactor = MAX(MIN(sf, 1.0), smin);
+}
