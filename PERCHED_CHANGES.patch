+int readSoil2Data(int j, char* toks[], int ntoks)
+//
+//  swmm524-perched: reads the lower (compacted) soil layer of a bio-retention
+//  cell.  Same fields as the SOIL line:
+//    LID_ID  SOIL2  Thickness  Porosity  FieldCap  WiltPt  Ksat  Kslope  Suction
+//  The layer replaces the STORAGE layer as the zone under the topsoil.  Its
+//  drainage to native soil is its own K(theta) capped by the STORAGE line's
+//  seepage rate (seepage 0 = impermeable below).
+//
+{
+    int    i;
+    double x[7];
+
+    if ( ntoks < 9 ) return error_setInpError(ERR_ITEMS, "");
+    for (i = 2; i < 9; i++)
+    {
+        if ( ! getDouble(toks[i], &x[i-2]) || x[i-2] < 0.0 )
+            return error_setInpError(ERR_NUMBER, toks[i]);
+    }
+    LidProcs[j].soil2.thickness = x[0] / UCF(RAINDEPTH);
+    LidProcs[j].soil2.porosity  = x[1];
+    LidProcs[j].soil2.fieldCap  = x[2];
+    LidProcs[j].soil2.wiltPoint = x[3];
+    LidProcs[j].soil2.kSat      = x[4] / UCF(RAINFALL);
+    LidProcs[j].soil2.kSlope    = x[5];
+    LidProcs[j].soil2.suction   = x[6] / UCF(RAINDEPTH);
+    LidProcs[j].perched = TRUE;
+    return 0;
+}
+
+//=============================================================================
+
+int readStructData(int j, char* toks[], int ntoks)
+//
+//  swmm524-perched: optional topsoil structure dynamics.
+//    LID_ID  STRUCT  DecayRate  RecoveryRate  MinFactor
+//  DecayRate (1/day) applies while the topsoil is within 0.01 of saturation,
+//  RecoveryRate (1/day) while it is at or below field capacity.  The factor
+//  multiplies the topsoil Ksat (surface entry and percolation).
+//
+{
+    int    i;
+    double x[3];
+
+    if ( ntoks < 5 ) return error_setInpError(ERR_ITEMS, "");
+    for (i = 2; i < 5; i++)
+    {
+        if ( ! getDouble(toks[i], &x[i-2]) || x[i-2] < 0.0 )
+            return error_setInpError(ERR_NUMBER, toks[i]);
+    }
+    if ( x[2] <= 0.0 || x[2] > 1.0 ) return error_setInpError(ERR_NUMBER, toks[4]);
+    LidProcs[j].structKd  = x[0];
+    LidProcs[j].structKr  = x[1];
+    LidProcs[j].structMin = x[2];
+    LidProcs[j].hasStruct = TRUE;
+    return 0;
+}
+
+//=============================================================================
+
+int readVGData(int j, char* toks[], int ntoks)
+//
+//  swmm524-perched: optional van Genuchten retention for the two soil layers
+//  of a perched bio-retention cell.
+//    LID_ID  VG  SOIL   ThetaR  Alpha  n  [EXP | MUALEM]
+//    LID_ID  VG  SOIL2  ThetaR  Alpha  n  [EXP | MUALEM]
+//    LID_ID  VG  GMAX   MaxUpwardGradient
+//    LID_ID  VG  OPTION TOPFC | FCDRAIN | SOIL2ET | FCHEAD | STEP
+//  Alpha is in 1/in (1/mm for SI units).  Each OPTION line puts back one
+//  perched-engine assumption, for controlled comparisons (see lidproc.c).  ThetaS is the layer's porosity.
+//  EXP (default) keeps the SOIL line's exponential K(theta); MUALEM uses
+//  vG-Mualem K(theta).  With both layers given, flow across the interface is
+//  driven by the head difference between layer midpoints (see lidproc.c).
+//
+{
+    int    i, k;
+    double x[3];
+
+    if ( ntoks < 4 ) return error_setInpError(ERR_ITEMS, "");
+    if ( strcomp(toks[2], "OPTION") )
+    {
+        if      ( strcomp(toks[3], "TOPFC") )   LidProcs[j].vgOpt |= VGOPT_TOPFC;
+        else if ( strcomp(toks[3], "FCDRAIN") ) LidProcs[j].vgOpt |= VGOPT_FCDRAIN;
+        else if ( strcomp(toks[3], "SOIL2ET") ) LidProcs[j].vgOpt |= VGOPT_SOIL2ET;
+        else if ( strcomp(toks[3], "FCHEAD") )  LidProcs[j].vgOpt |= VGOPT_FCHEAD;
+        else if ( strcomp(toks[3], "STEP") )    LidProcs[j].vgOpt |= VGOPT_STEP;
+        else return error_setInpError(ERR_KEYWORD, toks[3]);
+        return 0;
+    }
+    if ( strcomp(toks[2], "GMAX") )
+    {
+        if ( ! getDouble(toks[3], &x[0]) || x[0] <= 0.0 )
+            return error_setInpError(ERR_NUMBER, toks[3]);
+        LidProcs[j].vgGmax = x[0];
+        return 0;
+    }
+    if      ( strcomp(toks[2], "SOIL") )  k = 0;
+    else if ( strcomp(toks[2], "SOIL2") ) k = 1;
+    else return error_setInpError(ERR_KEYWORD, toks[2]);
+    if ( ntoks < 6 ) return error_setInpError(ERR_ITEMS, "");
+    for (i = 3; i < 6; i++)
+    {
+        if ( ! getDouble(toks[i], &x[i-3]) || x[i-3] < 0.0 )
+            return error_setInpError(ERR_NUMBER, toks[i]);
+    }
+    if ( x[1] <= 0.0 ) return error_setInpError(ERR_NUMBER, toks[4]);
+    if ( x[2] <= 1.0 ) return error_setInpError(ERR_NUMBER, toks[5]);
+    LidProcs[j].vgMualem[k] = 0;
+    if ( ntoks > 6 )
+    {
+        if      ( strcomp(toks[6], "MUALEM") ) LidProcs[j].vgMualem[k] = 1;
+        else if ( ! strcomp(toks[6], "EXP") )  return error_setInpError(ERR_KEYWORD, toks[6]);
+    }
+    LidProcs[j].vgThetaR[k] = x[0];
+    LidProcs[j].vgAlpha[k]  = x[1] * UCF(RAINDEPTH);    // 1/in or 1/mm -> 1/ft
+    LidProcs[j].vgN[k]      = x[2];
+    LidProcs[j].vgSet[k]    = TRUE;
+    return 0;
+}
